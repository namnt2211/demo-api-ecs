{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteAttachmentsObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::teamboard-attachments-<ten-cua-ban>/*"
    },
    {
      "Sid": "ListAttachmentsBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::teamboard-attachments-<ten-cua-ban>"
    }
  ]
}
